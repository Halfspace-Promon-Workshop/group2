// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  emailVerified           Boolean   @default(false)
  encryptedGithubToken    String?   @db.Text
  githubTokenIv           String?
  githubTokenCreatedAt    DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  monitors                Monitor[]
  pushSubscriptions       PushSubscription[]
  notifications           Notification[]
  auditLogs               AuditLog[]

  @@map("users")
}

model Monitor {
  id                    String        @id @default(uuid())
  userId                String
  name                  String        @db.VarChar(255)
  queryType             QueryType
  queryConfig           Json
  searchSurfaces        Json          // ['code', 'repo', 'issues', 'prs']
  intervalMinutes       Int
  enabled               Boolean       @default(true)
  lastRunAt             DateTime?
  nextRunAt             DateTime?
  status                MonitorStatus @default(active)
  errorMessage          String?       @db.Text
  notificationThreshold Int           @default(3)
  bullmqJobId           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs                  MonitorRun[]
  results               Result[]
  dedupeKeys            ResultDedupeKey[]

  @@index([userId, enabled, nextRunAt])
  @@map("monitors")
}

model MonitorRun {
  id                  String         @id @default(uuid())
  monitorId           String
  startedAt           DateTime       @default(now())
  completedAt         DateTime?
  status              RunStatus      @default(running)
  resultsFound        Int            @default(0)
  resultsNew          Int            @default(0)
  errorMessage        String?        @db.Text
  rateLimitRemaining  Int?
  rateLimitResetAt    DateTime?

  monitor             Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  results             Result[]

  @@index([monitorId, startedAt(sort: Desc)])
  @@map("monitor_runs")
}

model Result {
  id                  String         @id @default(uuid())
  monitorId           String
  monitorRunId        String
  entityType          EntityType
  entityId            String         @db.VarChar(255)
  title               String         @db.VarChar(500)
  url                 String         @db.Text
  repository          String         @db.VarChar(255)
  repositoryUrl       String         @db.Text
  path                String?        @db.VarChar(500)
  sha                 String?        @db.VarChar(40)
  excerpt             String?        @db.Text
  matchedTerms        Json           // array of matched keywords
  severity            Int            // 1-5
  severityExplanation  String         @db.Text
  status              ResultStatus   @default(new)
  tags                Json           // array of strings
  notes                String?        @db.Text
  firstSeenAt         DateTime       @default(now())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  monitor             Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorRun          MonitorRun     @relation(fields: [monitorRunId], references: [id], onDelete: Cascade)
  notifications       Notification[]

  @@unique([monitorId, entityType, entityId, sha])
  @@index([monitorId, createdAt(sort: Desc)])
  @@index([severity, status, createdAt(sort: Desc)])
  @@index([entityType, entityId, sha])
  @@map("results")
}

model ResultDedupeKey {
  id        String   @id @default(uuid())
  monitorId String
  dedupeKey String   @db.VarChar(500)
  createdAt DateTime @default(now())

  monitor   Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([monitorId, dedupeKey])
  @@index([monitorId, dedupeKey])
  @@map("result_dedupe_keys")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  resultId    String
  type        NotificationType
  status      NotificationStatus @default(pending)
  sentAt      DateTime?
  errorMessage String?          @db.Text
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  result      Result           @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @db.Text
  p256dhKey String   @db.Text
  authKey   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String   @db.VarChar(100)
  resourceType String?  @db.VarChar(50)
  resourceId   String?
  details      Json?
  ipAddress    String?  @db.VarChar(45)
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

enum QueryType {
  keyword
  collection
  standard
}

enum MonitorStatus {
  active
  paused
  error
}

enum RunStatus {
  running
  completed
  failed
  rate_limited
}

enum EntityType {
  code
  repo
  issue
  pr
}

enum ResultStatus {
  new
  seen
  triaged
  false_positive
}

enum NotificationType {
  web_push
  email
  slack
}

enum NotificationStatus {
  pending
  sent
  failed
}
